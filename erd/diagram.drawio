<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-10-08T18:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="phase3-erd" name="Page-1"><mxGraphModel dx="1512" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;div style=&quot;font-size:22px;font-weight:bold;&quot;&gt;Basketball 3v3 Tournament Database — Phase 3 ERD&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#666666;&quot;&gt;Crow's foot notation with PKs, FKs, participation, and linking tables&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="320" y="10" width="650" height="45" as="geometry"/></mxCell><mxCell id="coaches" value="&lt;div style=&quot;font-size:14px;font-weight:bold;text-align:center;&quot;&gt;Coaches&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;PK&lt;/b&gt; CoachID : INT&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;CoachFirstName : VARCHAR(50)&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;CoachLastName : VARCHAR(50)&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;CoachPhoneNumber : VARCHAR(20)&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;CoachEmail : VARCHAR(100)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;shadow=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="205" as="geometry"/></mxCell><mxCell id="teams" value="&lt;div style=&quot;font-size:14px;font-weight:bold;text-align:center;&quot;&gt;Teams&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;PK&lt;/b&gt; TeamID : INT&lt;/div&gt;